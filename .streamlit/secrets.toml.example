# Copy into Streamlit Cloud > App settings > Secrets, then replace placeholders.
# For local testing, copy to .streamlit/secrets.toml (ignored by Git).
# Use the same values as your existing DuckDB secrets.

[ducklake.postgres]
host = "YOUR_SUPABASE_HOST"
port = 5432
dbname = "postgres"
user = "YOUR_DATABASE_USER"
password = "YOUR_DATABASE_PASSWORD"

[ducklake.s3]
key_id = "YOUR_S3_ACCESS_KEY"
secret = "YOUR_S3_SECRET_KEY"
region = "YOUR_S3_REGION"
# Host only, without https://; match your existing S3 secret.
endpoint = "YOUR_S3_ENDPOINT"
url_style = "path"
use_ssl = true

[ducklake.catalog]
metadata_path = ""
# Match the existing lakehouse secret, including metadata_schema and data_path.
metadata_schema = "main"
data_path = "s3://YOUR_BUCKET/YOUR_EXISTING_LAKE_PREFIX/"
